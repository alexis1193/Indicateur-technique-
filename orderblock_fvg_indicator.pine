//@version=5
indicator("OB + FVG Toolkit — Alexis", overlay=true, max_boxes_count=500)

// ==================== INPUTS ====================
grp_fvg = "Fair Value Gap (FVG)"
showFVG          = input.bool(true, "Afficher les FVG", group=grp_fvg)
fvgBullColor     = input.color(color.new(color.teal, 70), "Couleur FVG haussier", group=grp_fvg)
fvgBearColor     = input.color(color.new(color.red, 70), "Couleur FVG baissier", group=grp_fvg)
fvgExtend        = input.int(20, "Extension des FVG non comblés (bougies)", minval=1, group=grp_fvg)
fvgRemoveOnFill  = input.bool(true, "Supprimer le FVG une fois comblé", group=grp_fvg)
fvgMinGapATR     = input.float(0.0, "Taille min. du gap (x ATR14, 0 = désactivé)", minval=0.0, step=0.1, group=grp_fvg)

grp_ob = "Order Blocks (OB)"
showOB               = input.bool(true, "Afficher les Order Blocks", group=grp_ob)
obSwingLength        = input.int(10, "Longueur de détection des swings", minval=2, group=grp_ob)
obBullColor          = input.color(color.new(color.blue, 75), "Couleur OB haussier", group=grp_ob)
obBearColor          = input.color(color.new(color.orange, 75), "Couleur OB baissier", group=grp_ob)
obExtend             = input.int(30, "Extension des OB non testés (bougies)", minval=1, group=grp_ob)
obRemoveOnMitigation = input.bool(true, "Supprimer l'OB une fois mitigé", group=grp_ob)
obUseBodyOnly        = input.bool(false, "Utiliser le corps de bougie uniquement (pas la mèche)", group=grp_ob)

grp_alert = "Alertes"
alertOnNewOB      = input.bool(false, "Alerte à la formation d'un nouvel OB", group=grp_alert)
alertOnNewFVG     = input.bool(false, "Alerte à la formation d'un nouveau FVG", group=grp_alert)
alertOnMitigation = input.bool(false, "Alerte quand un OB/FVG est testé", group=grp_alert)

// ==================== FONCTIONS DE GESTION DES ZONES ====================
// Étend une zone non testée, ou la supprime si le prix l'a retraversée.
// IMPORTANT : ces fonctions doivent être appelées AVANT la création d'une
// nouvelle zone sur la bougie en cours, sinon une zone tout juste créée
// serait immédiatement testée avec le prix de sa propre bougie de création
// et supprimée avant même d'être visible à l'écran.
manageFvg(arr, isBull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            b = array.get(arr, i)
            top = box.get_top(b)
            bot = box.get_bottom(b)
            filled = isBull ? low <= bot : high >= top
            if filled and fvgRemoveOnFill
                box.delete(b)
                array.remove(arr, i)
                if alertOnMitigation
                    alert((isBull ? "FVG haussier" : "FVG baissier") + " comblé sur " + syminfo.ticker, alert.freq_once_per_bar_close)
            else
                box.set_right(b, bar_index + fvgExtend)

manageOb(arr, isBull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            b = array.get(arr, i)
            top = box.get_top(b)
            bot = box.get_bottom(b)
            mitigated = isBull ? low <= top : high >= bot
            if mitigated and obRemoveOnMitigation
                box.delete(b)
                array.remove(arr, i)
                if alertOnMitigation
                    alert((isBull ? "Order Block haussier" : "Order Block baissier") + " mitigé sur " + syminfo.ticker, alert.freq_once_per_bar_close)
            else
                box.set_right(b, bar_index + obExtend)

// ==================== FVG ====================
atr14 = ta.atr(14)

var box[] bullFvgBoxes = array.new_box(0)
var box[] bearFvgBoxes = array.new_box(0)

// 1) On gère d'abord les zones existantes (créées lors des bougies précédentes)
manageFvg(bullFvgBoxes, true)
manageFvg(bearFvgBoxes, false)

// 2) Puis seulement on détecte et crée une nouvelle zone sur la bougie en cours
bullGap = low - high[2]
bearGap = low[2] - high

isBullFVG = showFVG and bullGap > 0 and (fvgMinGapATR == 0 or bullGap >= fvgMinGapATR * atr14)
isBearFVG = showFVG and bearGap > 0 and (fvgMinGapATR == 0 or bearGap >= fvgMinGapATR * atr14)

if isBullFVG
    b = box.new(bar_index[2], low, bar_index + fvgExtend, high[2], border_color=color.new(fvgBullColor, 0), bgcolor=fvgBullColor, extend=extend.none)
    array.push(bullFvgBoxes, b)
    if alertOnNewFVG
        alert("Nouveau FVG haussier détecté sur " + syminfo.ticker, alert.freq_once_per_bar_close)

if isBearFVG
    b = box.new(bar_index[2], low[2], bar_index + fvgExtend, high, border_color=color.new(fvgBearColor, 0), bgcolor=fvgBearColor, extend=extend.none)
    array.push(bearFvgBoxes, b)
    if alertOnNewFVG
        alert("Nouveau FVG baissier détecté sur " + syminfo.ticker, alert.freq_once_per_bar_close)

// ==================== ORDER BLOCKS ====================
var box[] bullObBoxes = array.new_box(0)
var box[] bearObBoxes = array.new_box(0)

// 1) On gère d'abord les zones existantes
manageOb(bullObBoxes, true)
manageOb(bearObBoxes, false)

// 2) Puis on détecte et crée une nouvelle zone sur la bougie en cours
swingHigh = ta.pivothigh(high, obSwingLength, obSwingLength)
swingLow  = ta.pivotlow(low, obSwingLength, obSwingLength)

if showOB and not na(swingLow) and close[obSwingLength] < open[obSwingLength]
    pivotBarIndex = bar_index - obSwingLength
    top = obUseBodyOnly ? math.max(open[obSwingLength], close[obSwingLength]) : high[obSwingLength]
    bot = obUseBodyOnly ? math.min(open[obSwingLength], close[obSwingLength]) : low[obSwingLength]
    b = box.new(pivotBarIndex, top, bar_index + obExtend, bot, border_color=color.new(obBullColor, 0), bgcolor=obBullColor, extend=extend.none)
    array.push(bullObBoxes, b)
    if alertOnNewOB
        alert("Nouvel Order Block haussier détecté sur " + syminfo.ticker, alert.freq_once_per_bar_close)

if showOB and not na(swingHigh) and close[obSwingLength] > open[obSwingLength]
    pivotBarIndex = bar_index - obSwingLength
    top = obUseBodyOnly ? math.max(open[obSwingLength], close[obSwingLength]) : high[obSwingLength]
    bot = obUseBodyOnly ? math.min(open[obSwingLength], close[obSwingLength]) : low[obSwingLength]
    b = box.new(pivotBarIndex, top, bar_index + obExtend, bot, border_color=color.new(obBearColor, 0), bgcolor=obBearColor, extend=extend.none)
    array.push(bearObBoxes, b)
    if alertOnNewOB
        alert("Nouvel Order Block baissier détecté sur " + syminfo.ticker, alert.freq_once_per_bar_close)
