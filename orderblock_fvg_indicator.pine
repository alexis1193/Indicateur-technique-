//@version=5
indicator("Order Blocks + FVG", overlay = true, max_boxes_count = 500)

// --- Inputs ---
showOB = input.bool(true, "Afficher les Order Blocks")
showFVG = input.bool(true, "Afficher les FVG")
extendBars = input.int(30, "Extension des zones (barres)", minval = 1)
swingLen = input.int(5, "Longueur de détection de structure (swing)", minval = 1)
atrLen = input.int(14, "Période ATR (filtre de significativité)", minval = 1)
obAtrMult = input.float(1.2, "Déplacement minimum pour un Order Block (x ATR)", minval = 0.1, step = 0.1)
fvgAtrMult = input.float(0.3, "Taille minimum d'un FVG (x ATR)", minval = 0.05, step = 0.05)
deleteOnMitigation = input.bool(true, "Supprimer une zone une fois retestée (mitigation)")

obColor = color.new(color.blue, 70)
fvgColor = color.new(color.fuchsia, 70)

atrVal = ta.atr(atrLen)

// --- Structure de marché : derniers swing high / low confirmés ---
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow := swingLow

// --- Cassure de structure (Break of Structure) ---
bosUp   = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bosDown = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow

// --- Déplacement significatif (filtre anti faux signal) ---
strongMoveUp   = close > open and (close - open) > atrVal * obAtrMult
strongMoveDown = open > close and (open - close) > atrVal * obAtrMult

// --- Order Blocks : dernière bougie opposée avant un déplacement qui casse la structure ---
bullishOB = bosUp and strongMoveUp and close[1] < open[1]
bearishOB = bosDown and strongMoveDown and close[1] > open[1]

var array<box> bullishBoxes = array.new<box>()
var array<box> bearishBoxes = array.new<box>()

if showOB and bullishOB
    array.push(bullishBoxes, box.new(bar_index[1], high[1], bar_index[1] + extendBars, low[1], border_color = color.blue, bgcolor = obColor))

if showOB and bearishOB
    array.push(bearishBoxes, box.new(bar_index[1], high[1], bar_index[1] + extendBars, low[1], border_color = color.blue, bgcolor = obColor))

// --- FVG filtré par taille minimum (ATR) ---
gapUpSize   = low - high[2]
gapDownSize = low[2] - high

bullishFVG = gapUpSize > 0 and gapUpSize > atrVal * fvgAtrMult
bearishFVG = gapDownSize > 0 and gapDownSize > atrVal * fvgAtrMult

var array<box> fvgBullBoxes = array.new<box>()
var array<box> fvgBearBoxes = array.new<box>()

if showFVG and bullishFVG
    array.push(fvgBullBoxes, box.new(bar_index[2], low, bar_index + extendBars, high[2], border_color = color.fuchsia, bgcolor = fvgColor))

if showFVG and bearishFVG
    array.push(fvgBearBoxes, box.new(bar_index[2], low[2], bar_index + extendBars, high, border_color = color.fuchsia, bgcolor = fvgColor))

// --- Mitigation : on supprime une zone dès qu'elle est retestée par le prix ---
if deleteOnMitigation
    if array.size(bullishBoxes) > 0
        for i = array.size(bullishBoxes) - 1 to 0
            b = array.get(bullishBoxes, i)
            if low <= box.get_bottom(b)
                box.delete(b)
                array.remove(bullishBoxes, i)
    if array.size(bearishBoxes) > 0
        for i = array.size(bearishBoxes) - 1 to 0
            b = array.get(bearishBoxes, i)
            if high >= box.get_top(b)
                box.delete(b)
                array.remove(bearishBoxes, i)
    if array.size(fvgBullBoxes) > 0
        for i = array.size(fvgBullBoxes) - 1 to 0
            b = array.get(fvgBullBoxes, i)
            if low <= box.get_bottom(b)
                box.delete(b)
                array.remove(fvgBullBoxes, i)
    if array.size(fvgBearBoxes) > 0
        for i = array.size(fvgBearBoxes) - 1 to 0
            b = array.get(fvgBearBoxes, i)
            if high >= box.get_top(b)
                box.delete(b)
                array.remove(fvgBearBoxes, i)
