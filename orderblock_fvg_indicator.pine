//@version=5
indicator("Order Blocks + FVG", overlay = true, max_boxes_count = 500)

// --- Inputs ---
showOB = input.bool(true, "Afficher les Order Blocks")
showFVG = input.bool(true, "Afficher les FVG")
extendBars = input.int(20, "Extension des zones (barres)", minval = 1)

obColor = color.new(color.blue, 70)
fvgColor = color.new(color.fuchsia, 70)

// --- Order Blocks ---
// Bullish OB : dernière bougie baissière avant une cassure haussière
bullishOB = close[1] < open[1] and close > open and close > high[1]
// Bearish OB : dernière bougie haussière avant une cassure baissière
bearishOB = close[1] > open[1] and close < open and close < low[1]

if showOB and bullishOB
    box.new(bar_index[1], high[1], bar_index[1] + extendBars, low[1], border_color = color.blue, bgcolor = obColor)

if showOB and bearishOB
    box.new(bar_index[1], high[1], bar_index[1] + extendBars, low[1], border_color = color.blue, bgcolor = obColor)

// --- FVG (Fair Value Gap) ---
// Bullish FVG : le plus bas de la bougie actuelle est au-dessus du plus haut d'il y a 2 bougies
bullishFVG = low > high[2]
// Bearish FVG : le plus haut de la bougie actuelle est en dessous du plus bas d'il y a 2 bougies
bearishFVG = high < low[2]

if showFVG and bullishFVG
    box.new(bar_index[2], low, bar_index + extendBars, high[2], border_color = color.fuchsia, bgcolor = fvgColor)

if showFVG and bearishFVG
    box.new(bar_index[2], low[2], bar_index + extendBars, high, border_color = color.fuchsia, bgcolor = fvgColor)
